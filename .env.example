# Copy to .env.local and fill in. sourcery reads these via process.env.
# You need ONE LLM key — whichever provider your answer/judge models use.
# Missing a retrieval-provider key just makes that provider's arm fail gracefully.

# LLM (answer + both judges). A bare model id (gpt-4o-mini) uses OpenAI; a
# "fireworks/..." model id uses Fireworks. Set the key matching your models.
OPENAI_API_KEY=
FIREWORKS_API_KEY=

# Bright Data — SERP retrieval + (optional) Web Unlocker page extraction.
BRIGHTDATA_API_TOKEN=
BRIGHTDATA_SERP_ZONE=sourcery_serp
BRIGHTDATA_UNLOCKER_ZONE=

# Firecrawl — /v2/search retrieval.
FIRECRAWL_API_KEY=

# Tavily — /search retrieval (RAG-tuned index).
TAVILY_API_KEY=

# Exa — /search retrieval (neural index; native publish dates).
EXA_API_KEY=

# Brave — its own crawler and index. Snippets only, never page text.
# Key: api-dashboard.search.brave.com/app/keys → "Add API key".
# Brave calls it a subscription token; it goes here under this name.
BRAVE_API_KEY=

# Serper — Google's results as JSON. Links and snippets, no page text.
# Key: serper.dev/dashboard → the key is on the dashboard once you're logged in.
# (serper.dev/api-key is a dead link.)
SERPER_API_KEY=

# Perplexity — the Search API, which returns pages. Not the chat models.
# Key: perplexity.ai/account/api/group → "Generate API key".
PERPLEXITY_API_KEY=

# Parallel — an index built for agents. Excerpts plus native publish dates.
# Key: platform.parallel.ai → sign in, then the API keys page.
PARALLEL_API_KEY=

# The `plain` arm needs no key at all — it's the keyless baseline.
# `sourcery providers` shows which of the above you're missing.
