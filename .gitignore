# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# production
/dist

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# sourcery CLI local output — runs.jsonl / captured queries never leave the machine
.sourcery/

# typescript
*.tsbuildinfo

# agent/session scaffolding — local only
AGENTS.md
CLAUDE.md
SESSION_HANDOFF.md
.claude/
design/

# Stale build output from the dashboard that was cut in 5314ecc. No `next`
# dependency remains; the directory is just what's left on disk.
.next/

# vhs recording scratch (the shim that makes the demo read as `sourcery`)
.vhs-bin/

# Local config written by `sourcery init` — holds YOUR model choices, not the repo's
sourcery.config.mjs
sourcery.config.js

# The results explorer and the report page are generated, and both are committed
# anyway: GitHub Pages serves what is in the repo, so an artifact nobody commits
# is a page nobody can open. Rebuild with scripts/build-explorer*.mjs and
# scripts/build-report.mjs after any change to the run data.
